\name{stop_websocket_server}
\alias{stop_websocket_server}
\title{Stop Rgent's local server}
\usage{
stop_websocket_server()
}
\description{
Stops the websocket server that connects the chat pane to your R session. The pane
stops responding until \code{\link{run_rgent}} is called again.
}
\value{\code{NULL}.}
